# Vercel gets the static site and the server functions. Everything else, .env included, stays local.
/*
!/vercel.json
!/package.json
!/package-lock.json
!/api
!/web
!/docs
!/executor
/executor/*
!/executor/proofs
!/executor/attestations.json
!/executor/sources.mjs
!/executor/forseti.mjs
!/executor/relay.mjs
