# NEAR AI Cloud key: create one at https://cloud.near.ai (never commit the real .env)
NEARAI_API_KEY=
# NEAR account the executor signs with (testnet)
NEAR_ACCOUNT_ID=
NEAR_PRIVATE_KEY=
FORSETI_CONTRACT=forseti.testnet
# Testnet-only EVM deployer/relayer for Base Sepolia (never put real funds here)
EVM_PRIVATE_KEY=
EVM_ADDRESS=
# Demo-only second accounts (appeal and a second bettor)
APPELLANT_ACCOUNT_ID=
APPELLANT_PRIVATE_KEY=
EVM2_PRIVATE_KEY=
EVM2_ADDRESS=
SHADY_ACCOUNT_ID=
SHADY_PRIVATE_KEY=
# Keys of the demo relay that the site's server signs with (npm run dev uses these; on Vercel they are
# set as NEAR_ACCOUNT_ID, NEAR_PRIVATE_KEY and EVM_PRIVATE_KEY). Testnet only.
RELAY_ACCOUNT_ID=
RELAY_PRIVATE_KEY=
EVM_RELAY_PRIVATE_KEY=
EVM_RELAY_ADDRESS=
